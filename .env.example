DATABASE_URL=postgres://user:password@127.0.0.1:5432/dbname
PAYLOAD_SECRET=generate-with-openssl-rand-hex-32
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Email (optional in dev: without SMTP_HOST, emails are printed in the server console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=site@fondationgacha.org
FORMS_TO_EMAIL=contact@fondationgacha.org

# Newsletter (optional): sync subscribers to the existing Mailchimp list
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=

# Live preview / draft mode
PREVIEW_SECRET=generate-with-openssl-rand-hex-16

# Production (Vercel): Supabase
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres   (Transaction pooler: Vercel has no IPv6)
# DATABASE_SCHEMA=foundation        (this site's tables live in their own schema: the Supabase project is shared)
# USE_SUPABASE_STORAGE=true         (photos in Supabase Storage instead of ./media)
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_…
# SUPABASE_BUCKET=fondation-media
